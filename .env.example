# Copiá este archivo a .env y completá tus claves.
# El repo no lleva claves: este archivo solo tiene los nombres de las variables.

# Proveedor del modelo de chat: gemini | openai | anthropic
LLM_PROVIDER=gemini

# Gemini (free tier): se saca en https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# La nube vectorial que reutilizo de la pre-entrega anterior (opcional).
# Sin esto el recuperador arranca en modo léxico (BM25) y el repo igual corre.
PINECONE_API_KEY=
INDEX_NAME=mi-indice-rag
PINECONE_NAMESPACE=politicas-internas

# --- Lo nuevo de esta pre-entrega -------------------------------------------------

# Redis: guarda la cola de trabajos y los checkpoints del grafo
REDIS_URL=redis://127.0.0.1:6379/0

# Phoenix (observabilidad). El dashboard queda en http://localhost:6006
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006/v1/traces
PHOENIX_PROJECT_NAME=pre-entrega-7

# Cuántos trabajos corre el worker a la vez y cuánto espera una aprobación
WORKER_CONCURRENCIA=3
MINUTOS_ESPERA_APROBACION=15

# Cuánto vive el estado de un trabajo en Redis y a partir de qué costo se pide aprobación
JOB_TTL_SEGUNDOS=86400
UMBRAL_COSTO_APROBACION=0.02

# Modelos (opcionales, tienen default)
# GEMINI_MODEL=gemini-flash-latest
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
